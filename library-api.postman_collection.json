				{
					"name": "查询借阅记录-读者视角（自动提取recordId）",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.code === 200 && res.data && res.data.length > 0) {",
									"    const pending = res.data.find(r => r.status === 0);",
									"    if (pending) {",
									"        pm.collectionVariables.set('recordId', pending.id);",
									"        console.log('已自动提取未归还记录 recordId=' + pending.id);",
									"    } else {",
									"        console.log('没有未归还的记录了');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
