{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-7890-abcd-1234567890ab",
		"name": "图书借阅管理系统-接口测试",
		"description": "登录+注册+权限+图书+借阅 全流程测试脚本。\n\n【使用步骤】\n1. 先在 MySQL 执行两条 SQL（改密码字段+MD5密码）\n2. 确认项目已启动 http://localhost:8081\n3. 先点【认证】里的「登录-管理员admin」和「登录-读者reader」，token会自动保存\n4. 之后所有请求直接点 Send 即可，token自动携带",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081"
		},
		{
			"key": "adminToken",
			"value": ""
		},
		{
			"key": "readerToken",
			"value": ""
		},
		{
			"key": "recordId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "① 认证（无需token）",
			"item": [
				{
					"name": "登录-管理员admin（自动保存token）",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.code === 200 && res.data && res.data.token) {",
									"    pm.collectionVariables.set('adminToken', res.data.token);",
									"    pm.test('管理员登录成功，token已自动保存', function () {",
									"        pm.expect(res.code).to.eql(200);",
									"    });",
									"} else {",
									"    pm.test('登录失败: ' + (res.msg || '未知错误') + '（检查是否已执行SQL修改密码）', function () {",
									"        pm.expect(res.code).to.eql(200);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "登录-读者reader（自动保存token）",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.code === 200 && res.data && res.data.token) {",
									"    pm.collectionVariables.set('readerToken', res.data.token);",
									"    pm.test('读者登录成功，token已自动保存', function () {",
									"        pm.expect(res.code).to.eql(200);",
									"    });",
									"} else {",
									"    pm.test('登录失败: ' + (res.msg || '未知错误'), function () {",
									"        pm.expect(res.code).to.eql(200);",
									"    });",
									"}"
								]
							}
						}
					],
